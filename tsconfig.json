{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "moduleDetection": "force"
  },
  "include": [
    "protocol/**/*.ts",
    "client/**/*.ts",
    "scripts/**/*.ts",
    "testing/**/*.ts",
    "test/**/*.ts",
    "types/**/*.d.ts"
  ]
}
